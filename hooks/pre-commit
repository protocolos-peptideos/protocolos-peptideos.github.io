#!/bin/sh
# Hook de pre-commit: roda a trava de datas antes de deixar commitar.
#
# Por que existe: build/gerar.py ja chama a trava, mas so protege quem roda o
# gerador. Neste repositorio ha sessoes paralelas que commitam com `git add -A`
# sem passar pelo gerador -- e para essas o hook e a unica barreira.
#
# Fica versionado em hooks/ e nao em .git/hooks/, que o git nao versiona.
# Para ligar num clone novo, de dentro do repositorio:
#
#     git config core.hooksPath hooks
#
# Para pular deliberadamente numa emergencia: git commit --no-verify
#
# Checa a arvore de trabalho, nao o indice. Com `git add -A` da no mesmo; se
# voce estiver commitando so parte do que editou, a diferenca existe.

set -e

RAIZ=$(git rev-parse --show-toplevel)
TRAVA="$RAIZ/build/trava_datas.py"

[ -f "$TRAVA" ] || exit 0   # trava ausente nao trava commit

# no Windows o interpretador pode ser python, python3 ou py
PY=""
for c in python python3 py; do
    if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done

if [ -z "$PY" ]; then
    echo "pre-commit: nao achei o Python; trava de datas NAO rodou." >&2
    echo "            commit liberado, mas confira com build/trava_datas.py" >&2
    exit 0
fi

if ! "$PY" "$TRAVA"; then
    echo "" >&2
    echo "COMMIT BLOQUEADO pela trava de datas." >&2
    echo "A data do site e fato historico: nao se escreve a mao nem se tira" >&2
    echo "do relogio. Arrume as linhas acima, ou use --no-verify se souber" >&2
    echo "o que esta fazendo." >&2
    exit 1
fi

# Segunda trava: contagem publicada vem com a consulta que a produziu.
TRAVA2="$RAIZ/build/trava_consultas.py"

if [ -f "$TRAVA2" ]; then
    if ! "$PY" "$TRAVA2"; then
        echo "" >&2
        echo "COMMIT BLOQUEADO pela trava de consultas." >&2
        echo "Contagem publicada tem que trazer a consulta que a produziu:" >&2
        echo "numero que o leitor nao consegue repetir e autoridade, nao" >&2
        echo "evidencia. Arrume as linhas acima, ou use --no-verify." >&2
        exit 1
    fi
fi

# Terceira trava: a aritmetica das tabelas de reconstituicao fecha sozinha.
# volume = dose / concentracao. Um erro ali e erro de dose por fator de 2 ou
# de 10 -- e foi assim que "1,125 mL" virou "1.125 mL" na tirzepatida, que em
# portugues se le como mil cento e vinte e cinco mililitros.
TRAVA3="$RAIZ/build/trava_reconstituicao.py"

if [ -f "$TRAVA3" ]; then
    if ! "$PY" "$TRAVA3"; then
        echo "" >&2
        echo "COMMIT BLOQUEADO pela trava de reconstituicao." >&2
        echo "A tabela nao fecha com a propria conta: volume = dose /" >&2
        echo "concentracao. Confira os numeros acima, ou use --no-verify se" >&2
        echo "souber o que esta fazendo." >&2
        exit 1
    fi
fi

# Quarta trava: o CSS critico inline no <head> foi tirado do estilo.css atual.
# Esta e a que mais precisa do hook. As outras protegem numero publicado, que
# alguem eventualmente confere lendo a pagina. Esta protege a PRIMEIRA PINTURA:
# se o critico envelhecer, a pagina pronta continua certa e so o primeiro
# quadro sai errado. Ninguem descobre isso olhando o site.
TRAVA4="$RAIZ/build/trava_critico.py"

if [ -f "$TRAVA4" ]; then
    if ! "$PY" "$TRAVA4"; then
        echo "" >&2
        echo "COMMIT BLOQUEADO pela trava de critico." >&2
        echo "estilo.css mudou e o recorte inline nao foi refeito. Rode o" >&2
        echo "extrator (build/extrai_critico.js) e regrave" >&2
        echo "assets/critico-gerado.css, ou use --no-verify." >&2
        exit 1
    fi
fi
